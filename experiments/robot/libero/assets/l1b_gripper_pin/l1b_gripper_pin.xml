<mujoco model="l1b_gripper_pin">
  <worldbody>
    <body>
      <body name="object">
        <!-- A finger-height pin: tall enough for fingertip contact, but below
             the wrist / palm swept volume.  Matching visual and collision
             geometry makes any interpenetration directly visible. -->
        <geom name="pin_visual" type="cylinder" pos="0 0 0"
              size="0.016 0.035" contype="0" conaffinity="0"
              rgba="0.12 0.45 0.86 1" group="1"/>
        <geom name="pin_base_visual" type="cylinder" pos="0 0 -0.031"
              size="0.022 0.004" contype="0" conaffinity="0"
              rgba="0.12 0.18 0.25 1" group="1"/>
        <geom name="pin_collision" type="cylinder" pos="0 0 0"
              size="0.016 0.035" density="220" friction="0.75 0.2 0.05"
              rgba="0.12 0.45 0.86 1" group="0"/>
        <geom name="pin_base" type="cylinder" pos="0 0 -0.031"
              size="0.022 0.004" density="400" friction="0.8 0.2 0.05"
              rgba="0.12 0.18 0.25 1" group="0"/>
      </body>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 -0.035" name="bottom_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 0.035" name="top_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0.022 0 0" name="horizontal_radius_site"/>
    </body>
  </worldbody>
</mujoco>
