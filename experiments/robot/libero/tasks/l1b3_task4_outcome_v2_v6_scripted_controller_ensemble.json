{
  "schema_version": 2,
  "id": "model_independent_scripted_osc_ensemble_v2",
  "purpose": "prospective scene construction and corridor stress audit only; never an evaluated learned policy",
  "task_suite_name": "libero_goal",
  "task_id": 4,
  "family": "l1b3_task4_outcome_v2_v6",
  "action_interface": "7-D OSC delta position, delta rotation, gripper",
  "obstacle_adaptive": false,
  "learned_action_prefix": false,
  "profile_order": [
    "canonical_center",
    "stress_x_plus",
    "stress_x_minus",
    "holdout_y_plus",
    "holdout_y_minus"
  ],
  "candidate_generation_profiles": ["canonical_center"],
  "construction_gate_profiles": [
    "canonical_center",
    "stress_x_plus",
    "stress_x_minus"
  ],
  "source_level_holdout_profiles": ["holdout_y_plus", "holdout_y_minus"],
  "holdout_rule": "holdout paths never generate or refine a pose; audit the first construction-qualified pose once, and reject the complete native source on any failure",
  "common_arguments": {
    "seed": 42,
    "position_scale": 0.08,
    "max_position_command": 0.5,
    "position_tolerance": 0.025,
    "precise_position_tolerance": 0.006,
    "max_waypoint_steps": 400,
    "transport_max_waypoint_steps": 700,
    "transport_max_position_command": 0.15,
    "transport_position_tolerance": 0.025,
    "grasp_include_diagonal_offsets": false,
    "grasp_order_away_from_obstacle": false,
    "disable_cross_episode_grasp_cache": true,
    "orient_before_grasp": false,
    "transport_obstacle_clearance": 0.0,
    "transport_clearance": 0.04,
    "approach_height": 0.12,
    "grasp_candidate_order": "center_then_axes",
    "grasp_offset_fractions": "0.80",
    "grasp_height": 0.015,
    "grasp_seat_steps": 15,
    "grasp_seat_max_command": 0.08,
    "lift_height": 0.08,
    "min_grasp_lift": 0.03,
    "preplace_height": 0.06,
    "place_offset_x": 0.0,
    "place_offset_y": 0.0,
    "confirm_support_after_release": true,
    "max_post_release_displacement": 0.05,
    "max_occluder_displacement": 0.001,
    "environment_horizon": 2000,
    "trajectory_track_bodies": "akita_black_bowl_1_main,wooden_cabinet_1_main,wine_bottle_1_main,robot0_link5,robot0_link6,robot0_link7"
  },
  "profiles": {
    "canonical_center": {
      "role": "candidate_generation_and_construction_gate",
      "pregrasp_target_offset_xy_m": [0.0, 0.0]
    },
    "stress_x_plus": {
      "role": "construction_gate",
      "pregrasp_target_offset_xy_m": [0.06, 0.0]
    },
    "stress_x_minus": {
      "role": "construction_gate",
      "path_shape": "negative_x_positive_y_dogleg",
      "pregrasp_target_offset_xy_m": [-0.06, 0.06]
    },
    "holdout_y_plus": {
      "role": "source_level_holdout",
      "pregrasp_target_offset_xy_m": [0.0, 0.06]
    },
    "holdout_y_minus": {
      "role": "source_level_holdout",
      "pregrasp_target_offset_xy_m": [0.0, -0.06]
    }
  },
  "diversity_gate": {
    "measured_body": "robot0_link6",
    "metric": "maximum time-normalized pairwise XY separation over 128 samples",
    "minimum_pairwise_path_separation_m": 0.025,
    "episode_zero_canary_before_full_pool": true,
    "failure_action": "reject_complete_native_source"
  },
  "selection_thresholds": {
    "minimum_translation_m": 0.01,
    "minimum_tilt_change_deg": 30.0,
    "maximum_calibration_penetration_m": 0.001,
    "maximum_formal_rollout_penetration_m": 0.002
  }
}
