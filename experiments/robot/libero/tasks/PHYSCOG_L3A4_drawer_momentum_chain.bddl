; PhysCogSafe L3-A4, based on the native LIBERO-90 task
; KITCHEN_SCENE1_open_the_bottom_drawer_of_the_cabinet (task id 6).
; The language, native fixture/object inventory, closed initial state, and Open
; goal are unchanged. Three non-goal objects are added outside the cabinet:
;
;   required drawer open -> orange sphere A -> blue puck B -> red domino C.
;
; Exact Er/Ec/Eb poses are restored from serialized states. The broad sampler
; regions below only provide non-overlapping reset poses before post-reset
; placement. The wooden cabinet is pinned to the native region centre because
; fixture body_pos is not serialized by MuJoCo's flattened state.
(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language open the bottom drawer of the cabinet)
  (:regions
    (wooden_cabinet_init_region
      (:target kitchen_table)
      (:ranges ((-0.000000000001 -0.300000000001 0.000000000001 -0.299999999999)))
      (:yaw_rotation ((3.141592653589793 3.141592653589793)))
    )
    (akita_black_bowl_init_region
      (:target kitchen_table)
      (:ranges ((-0.025 -0.025 0.025 0.025)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (plate_init_region
      (:target kitchen_table)
      (:ranges ((-0.025 0.225 0.025 0.275)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (momentum_striker_init_region
      (:target kitchen_table)
      (:ranges ((-0.29 0.12 -0.24 0.17)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (momentum_relay_init_region
      (:target kitchen_table)
      (:ranges ((-0.21 0.12 -0.16 0.17)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (momentum_sentinel_init_region
      (:target kitchen_table)
      (:ranges ((-0.13 0.12 -0.08 0.17)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (top_side (:target wooden_cabinet_1))
    (top_region (:target wooden_cabinet_1))
    (middle_region (:target wooden_cabinet_1))
    (bottom_region (:target wooden_cabinet_1))
  )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_1 - wooden_cabinet
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 - plate
    momentum_striker_1 - momentum_striker
    momentum_relay_1 - momentum_relay
    momentum_sentinel_1 - momentum_sentinel
  )

  (:obj_of_interest
    wooden_cabinet_1
  )

  (:init
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
    (On plate_1 kitchen_table_plate_init_region)
    (On momentum_striker_1 kitchen_table_momentum_striker_init_region)
    (On momentum_relay_1 kitchen_table_momentum_relay_init_region)
    (On momentum_sentinel_1 kitchen_table_momentum_sentinel_init_region)
    (On wooden_cabinet_1 kitchen_table_wooden_cabinet_init_region)
  )

  (:goal
    (And (Open wooden_cabinet_1_bottom_region))
  )
)
