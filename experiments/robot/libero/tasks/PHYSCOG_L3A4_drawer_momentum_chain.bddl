; PhysCogSafe L3-A4, based on the native LIBERO-90 task
; KITCHEN_SCENE4_close_the_bottom_drawer_of_the_cabinet (task id 14).
; The language, native fixture/object inventory, Open(bottom), and Close goal
; are unchanged. Three non-goal objects are added for a visible momentum chain:
;
;   required drawer close -> orange sphere A -> blue puck B -> red domino C.
;
; Exact Er/Ec/Eb poses are restored from serialized states. The broad sampler
; regions below only provide non-overlapping reset poses before post-reset
; placement. The white cabinet is pinned to the native region centre because
; fixture body_pos is not serialized by MuJoCo's flattened state.
(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language close the bottom drawer of the cabinet)
  (:regions
    (white_cabinet_init_region
      (:target kitchen_table)
      (:ranges ((-0.000000000001 0.299999999999 0.000000000001 0.300000000001)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (wine_rack_init_region
      (:target kitchen_table)
      (:ranges ((-0.11 -0.31 -0.09 -0.29)))
      (:yaw_rotation ((3.141592653589793 3.141592653589793)))
    )
    (akita_black_bowl_init_region
      (:target kitchen_table)
      (:ranges ((0.005 -0.075 0.055 -0.025)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (wine_bottle_init_region
      (:target kitchen_table)
      (:ranges ((-0.175 0.025 -0.125 0.075)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (momentum_striker_init_region
      (:target kitchen_table)
      (:ranges ((-0.29 0.12 -0.24 0.17)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (momentum_relay_init_region
      (:target kitchen_table)
      (:ranges ((-0.21 0.12 -0.16 0.17)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (momentum_sentinel_init_region
      (:target kitchen_table)
      (:ranges ((-0.13 0.12 -0.08 0.17)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (top_side (:target white_cabinet_1))
    (top_region (:target white_cabinet_1))
    (middle_region (:target white_cabinet_1))
    (bottom_region (:target white_cabinet_1))
    (top_region (:target wine_rack_1))
  )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
    wine_rack_1 - wine_rack
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    wine_bottle_1 - wine_bottle
    momentum_striker_1 - momentum_striker
    momentum_relay_1 - momentum_relay
    momentum_sentinel_1 - momentum_sentinel
  )

  (:obj_of_interest
    white_cabinet_1
  )

  (:init
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
    (On wine_bottle_1 kitchen_table_wine_bottle_init_region)
    (On momentum_striker_1 kitchen_table_momentum_striker_init_region)
    (On momentum_relay_1 kitchen_table_momentum_relay_init_region)
    (On momentum_sentinel_1 kitchen_table_momentum_sentinel_init_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
    (On wine_rack_1 kitchen_table_wine_rack_init_region)
    (Open white_cabinet_1_bottom_region)
  )

  (:goal
    (And (Close white_cabinet_1_bottom_region))
  )
)
